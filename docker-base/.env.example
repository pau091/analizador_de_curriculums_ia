# Copia este archivo como .env y completa los valores. No versiones el .env.

# Proveedor del modelo: ollama (local, por defecto) u openai
LLM_PROVIDER=ollama

# Ollama. Dentro de Docker, docker-compose.yml sustituye OLLAMA_BASE_URL por
# http://host.docker.internal:11434 para llegar al Ollama del equipo anfitrión.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192

# OpenAI (solo si LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Obligatorias para docker-compose.yml (el analizador de CV no las usa)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=app_db
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=cambia_esta_clave
PGADMIN_SERVERS_JSON={"Servers":{"1":{"Name":"PostgreSQL","Group":"Servers","Host":"db","Port":5432,"MaintenanceDB":"postgres","Username":"postgres","SSLMode":"prefer"}}}

# Opcionales
POSTGRES_PORT=5433
PGADMIN_PORT=5050
